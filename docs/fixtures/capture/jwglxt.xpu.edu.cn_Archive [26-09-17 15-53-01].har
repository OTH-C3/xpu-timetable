          "content": {
            "mimeType": "application/javascript",
            "size": 1343,
            "text": "var schoolName;\n$.ajax({\n  url: window.CONTEXT_PATH + '/params/get-schoolName',\n  type: 'get',\n  async: false,\n  success: function (res) {\n    schoolName = res.schoolName ? res.schoolName.value : '';\n  }\n})\n\nvar globalVariable = {\n\n  schoolName: schoolName\n\n}\n// datetimepicker\n$.fn.datetimepicker.defaults.keepInvalid = true;\n\n// fileinput\n$.fn.fileinput.defaults.browseIcon = '<i class=\"iconfont icon-wenjianjia-kai\"></i>&nbsp;';\n$.fn.fileinput.defaults.browseClass = 'btn btn-primary-plain';\n$.fn.fileinput.defaults.showUpload = false;\n$.fn.fileinput.defaults.showPreview = false;\n\n// button\n$.fn.button.Constructor.DEFAULTS.loadingText = '请稍后...';\n\n$.fn.button.Constructor.prototype.setState = function (state){\n  var d = 'disabled';\n  var loadingClass = 'e-b-loading';\n  var $el = this.$element;\n  var val = $el.is('input') ? 'val' : 'html';\n  var data = $el.data();\n\n  state += 'Text'\n\n  if (data.resetText == null) $el.data('resetText', $el[val]())\n\n  // push to event loop to allow forms to submit\n  setTimeout($.proxy(function () {\n    $el[val](data[state] == null ? this.options[state] : data[state])\n\n    if (state == 'loadingText') {\n      this.isLoading = true\n      $el.addClass(d).addClass(loadingClass).attr(d, d).prop(d, true)\n    } else if (this.isLoading) {\n      this.isLoading = false\n      $el.removeClass(d).removeClass(loadingClass).removeAttr(d).prop(d, false)\n    }\n  }, this), 0)\n}\n\n\n//开关未开放弹窗，如果开关数据在MODULE_SWITCH表中，使用（FormUtil.isOpenSwitchByModule），如果不在，就用 （switchAlterWindow（））\nvar switchAlterWindow = function (res) {\n  $(\".switchCheckModel\").modal({\n    backdrop: true,\n    show: true\n  });\n  if(!res.success){\n    $(\".switchCheckModel .switchMessage\").text('功能未开放');\n    if (res.message !='' && res.message != null){\n      $(\".switchCheckModel .switchMessage\").text(res.message);\n      $(\".switchCheckModel .switchMessage\").show();\n    }\n    if (res.openDateMsgTip !='' && res.openDateMsgTip != null){\n      $(\".switchCheckModel .openDateMsgTip\").text(res.openDateMsgTip);\n      $(\".switchCheckModel .openDateMsgTip\").show();\n    }else {\n      $(\".switchCheckModel .openDateMsgTip\").text('');\n      $(\".switchCheckModel .openDateMsgTip\").hide();\n    }\n\n    if (res.openDate !='' && res.openDate != null ){\n      $(\".switchCheckModel .openDate\").text(res.openDate);\n      $(\".switchCheckModel .openDate\").show();\n      if (res.openDateMsgTip =='' || res.openDateMsgTip == null){\n        $(\".switchCheckModel .openDateMsgTip\").text(\"开放时间\");\n        $(\".switchCheckModel .openDateMsgTip\").show();\n      }\n    }else{\n      $(\".switchCheckModel .openDate\").text('');\n      $(\".switchCheckModel .openDate\").hide();\n    }\n    if (res.bulletin !='' && res.bulletin!=null){\n      //公告暂未开发\n    }\n  }\n}\n\nwindow.addEventListener('load',function(){\n  if(window.parent === window) {\n    return ;\n  }\n  window.parent.postMessage('refreshButton:reset');\n})\n\n// valid添加小数位验证\n$.validator.addMethod(\"maxScale\", function (value, element) {\n  var result = (value.match('\\^\\-\\?\\\\d+\\.\\?\\\\d{0,2}$'));\n  return this.optional(element) || result;\n}, \"小数位数最多2位\");\n"
          },
          "redirectURL": "",
          "headersSize": 0,
          "bodySize": 1343
        },
        "cache": {},
        "timings": {
