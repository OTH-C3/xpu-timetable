            "mimeType": "application/javascript",
            "size": 1181,
            "text": "$(function () {\n\n  var PageHeader = function (ele, options) {\n    this.$el = ele;\n    this.options = options;\n    this.render()\n  }\n\n  PageHeader.prototype.render = function () {\n    this.$template = $(`\n      <div class=\"eams-page-header\" >\n        <div class=\"page-back\" >\n          <a href=\"${this.options.backUrl}\">\n          <i>\n            <svg aria-hidden=\"true\" class=\"icon\">\n              <use xlink:href=\"#icon-arrow-left\"></use>\n            </svg>\n          </i>\n          </a>\n        </div>\n        <div class=\"page-header-title\" \n        style=\"font-size:${this.options.fontSize}px;color:${this.options.color};\"\n        >${this.options.title}</div>\n        <div class=\"page-header-slot\"></div>\n      </div>\n    `);\n    this.$slot = this.$template.find(\".page-header-slot\");\n    this.$pageBack = this.$template.find(\".page-back a\");\n    this.$el.append(this.$template)\n    if (typeof this.options.slot === 'function') {\n      this.$slot.append(this.options.slot());\n    }\n    if(typeof this.options.slot === 'string') {\n      this.$slot.find(\".page-header-slot\").append(this.options.slot);\n    }\n    if( this.options.slot instanceof jQuery){\n      this.options.slot.prependTo(this.$slot)\n    }\n\n    this.$pageBack.unbind('click').on('click',function(e){\n      const _href = $(this).attr('href');\n      if(!_href){\n        e.preventDefault();\n        pageBack([\"REDIRECT_URL\", \"PARENT_URL\"]);\n      }\n\n    })\n  }\n\n\n  $.fn.pageHeader = function (options) {\n    options = $.extend({}, $.fn.pageHeader.defaults, {title: $(\"title\").text()}, options);\n    new PageHeader(this, options);\n  }\n\n  $.fn.pageHeader.defaults = {\n    title: '',//标题\n    backUrl: '',//返回的地址,\n    fontSize: 16,\n    color: '#222',\n    slot: null\n  }\n\n  $(\"eams-page-header\").each(function(index,item){\n    $(item).pageHeader({\n      title:$(item).attr(\"title\"),\n      backUrl:$(item).attr('backUrl'),\n      fontSize:$(item).attr(\"fontSize\") || null,\n      color:$(item).attr(\"color\") || null,\n      slot:$(item).children()\n    })\n  })\n\n});\n\n/**\n * 使用说明\n * 1、自定义标签写法\n * <eams-page-header\n * title=\"这里是标题\"\n * backUrl=\"这里是返回的地址\"\n * >\n * // 此处相当于slot，将被添加至page-header-slot中，特殊样式要自己定义\n * <button>其他的按钮</button>\n * <span>...</span>\n * ...\n *\n * </eams-page-header>\n *\n * 2、插件初始化写法\n * $el.pageHeader({\n *   title: '你的标题',\n *   backUrl:'你的返回地址',\n *   fontSize: 14,  //标题字号，可不填，默认16\n *   color: 'red'||'#11ffff', //标题颜色，可不填，\n *   slot: '<button>other</button>' // 插槽，String|jQueryObject|Function ()=> String|jQueryObject\n * })\n * */"
          },
          "redirectURL": "",
