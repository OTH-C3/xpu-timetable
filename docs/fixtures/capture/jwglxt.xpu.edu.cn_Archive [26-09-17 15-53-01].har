            "mimeType": "application/javascript",
            "size": 4329,
            "text": "var i18nYesOrNoColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"是\" : \"否\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"yes\" : \"no\")\n      }\n    }\n  };\n}\n\nvar i18nRetakeColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '正常' : '<span style=\"color:red\">重修</span>')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? 'Normal' : '<span style=\"color:red\">Retake</span>')\n      }\n    }\n  }\n}\n\nvar i18nTeachingColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"授课\" : \"不授课\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"teaching\" : \"no teaching\")\n      }\n    }\n  };\n}\n\n\nvar i18nTakeChargeColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"担任\" : \"不担任\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"take charge\" : \"not take charge\")\n      }\n    }\n  };\n}\n\n\nvar i18nIncumbencyColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"在职\" : \"不在职\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"incumbency\" : \"not Incumbency\")\n      }\n    }\n  };\n}\n\nvar i18nAllowColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"allowStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"allowStatus\" style=\"color:red\">不允许</span>' : '<span class=\"allowStatus\" style=\"color:red\">not allow</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"允许\" : \"allow\";\n      }\n    }\n  };\n}\n\n\nvar i18nSubmitColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"submitStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"submitStatus\" style=\"opacity:0.4\">未提交</span>' : '<span class=\"submitStatus\" style=\"opacity:0.4\">not submit</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"已提交\" : \"submitted\";\n      }\n    }\n  };\n}\n\n\nvar i18nPublishColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"publishStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"publishStatus\" style=\"opacity:0.4\">未发布</span>' : '<span class=\"publishStatus\" style=\"opacity:0.4\">not publish</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"已发布\" : \"published\";\n      }\n    }\n  };\n}\n\nvar i18nEnableColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"enableStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"enableStatus\" style=\"color:red\">不启用</span>' : '<span class=\"enableStatus\" style=\"color:red\">not enabled</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"启用\" : \"enable\";\n      }\n    }\n  };\n}\n\nvar i18nOpenCourseColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"openCourseStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"openCourseStatus\" style=\"color:red\">不开课</span>' : '<span class=\"openCourseStatus\" style=\"color:red\">not open course</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"开课\" : \"open course\";\n      }\n    }\n  };\n}\n\n\nvar i18nMergeColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"mergeStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"mergeStatus\" style=\"opacity:0.4\">未合并</span>' : '<span class=\"mergeStatus\" style=\"opacity:0.4\">not merge</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"合并\" : \"merged\";\n      }\n    }\n  };\n}\n\n\nvar i18nSettingColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"setStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"setStatus\" style=\"opacity:0.4\">未设置</span>' : '<span class=\"setStatus\" style=\"opacity:0.4\">not set</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"已设置\" : \"set\";\n      }\n    }\n  };\n}\n\n\nvar i18nZaiJiColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"zaiJiStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"zaiJiStatus\" style=\"color:red\">不在籍</span>' : '<span class=\"zaiJiStatus\" style=\"color:red\">not enabled</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"在籍\" : \"enable\";\n      }\n    }\n  };\n}\n\n\nvar i18nInSchoolColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"inSchoolStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"inSchoolStatus\" style=\"color:red\">不在校</span>' : '<span class=\"inSchoolStatus\" style=\"color:red\">not in school</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"在校\" : \"enable\";\n      }\n    }\n  };\n}\n\n\nvar i18nHasXueJiColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"hasXueJiStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"hasXueJiStatus\" style=\"color:red\">无学籍</span>' : '<span class=\"hasXueJiStatus\" style=\"color:red\">not in school</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"有学籍\" : \"enable\";\n      }\n    }\n  };\n}\n\n\nvar i18nNeedRegisterColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"needRegister\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return window.LOCALE == 'zh' ? \"不需要注册\" : \"no need register\";\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"需要注册\" : \"enable\";\n      }\n    }\n  };\n}\n\n\nvar i18nAssignColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      var statusDom = '<input type=\"hidden\" class=\"assignStatus\" value=\"' + field.data + '\">';\n      if (field.data == null) {\n        return ' ';\n      }\n      if (!field.data) {\n        return (window.LOCALE == 'zh' ? '<span class=\"assignStatus\" style=\"opacity:0.4\">未指派</span>' : '<span class=\"assignStatus\" style=\"opacity:0.4\">not assign</span>') + statusDom;\n      }\n      if (field.data) {\n        return window.LOCALE == 'zh' ? \"已指派\" : \"assigned\";\n      }\n    }\n  };\n}\n\n\nvar i18nLocaleName = function (fieldName) {\n  var column = {};\n\n  if (fieldName === 'course') {\n    column = {\n      \"data\": fieldName,\n      \"render\": function (field, row) {\n        if (field.data == null) {\n          return '';\n        }\n        if (window.LOCALE === 'zh') {\n          return field.data.nameZh +\n              '&nbsp; <sup class=\"text-muted\">' + (row.data && row.data.minorCourse && row.data.minorCourse != null ? row.data.minorCourse.nameZh : '') + '</sup>';\n        } else {\n          return field.data.nameEn ? field.data.nameEn : field.data.nameZh +\n              '&nbsp; <sup class=\"text-muted\">' + (row.data && row.data.minorCourse && row.data.minorCourse != null ? (row.data.minorCourse.nameEn ? row.data.minorCourse.nameEn : row.data.minorCourse.nameZh) : '') + '</sup>';\n        }\n      }\n    }\n  } else if (fieldName === 'lesson.course') {\n    column = {\n      \"data\": fieldName,\n      \"render\": function (field, row) {\n        if (row.data.lesson == null || row.data.lesson.course == null) {\n          return '';\n        }\n        if (window.LOCALE === 'zh') {\n          return field.data.nameZh +\n              '&nbsp; <sup class=\"text-muted\">' + (row.data && row.data.lesson.minorCourse && row.data.lesson.minorCourse != null ? row.data.lesson.minorCourse.nameZh : '') + '</sup>';\n        } else {\n          return field.data.nameEn ? field.data.nameEn : field.data.nameZh +\n              '&nbsp; <sup class=\"text-muted\">' + (row.data && row.data.lesson.minorCourse && row.data.lesson.minorCourse != null ? (row.data.lesson.minorCourse.nameEn ? row.data.lesson.minorCourse.nameEn : row.data.lesson.minorCourse.nameZh) : '') + '</sup>';\n        }\n      }\n    }\n  } else {\n    column = {\n      \"data\": fieldName,\n      \"render\": function (field, row) {\n        if (field.data == null) {\n          return '';\n        }\n\n        if (window.LOCALE === 'zh') {\n          return !fieldName ? row.data.nameZh : field.data.nameZh;\n        } else {\n          return !fieldName ? (row.data.nameEn ? row.data.nameEn : row.data.nameZh) : (field.data.nameEn ? field.data.nameEn : field.data.nameZh);\n        }\n      }\n    }\n  }\n  return column;\n}\n\nvar i18nLocaleText = function (fieldName) {\n\n  var column = {\n    \"data\": fieldName,\n    \"render\": function (field, row) {\n      if (window.LOCALE === 'zh') {\n        return !fieldName ? row.data.TextZh : field.data.TextZh;\n      } else {\n        return !fieldName ? (row.data.TextEn ? row.data.TextEn : row.data.TextZh) : (field.data.TextEn ? field.data.TextEn : field.data.TextZh);\n      }\n    }\n  }\n  return column;\n}\n\nvar i18nInnovationColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"是\" : \"否\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"innovation\" : \"no innovation\")\n      }\n    }\n  }\n}\n\nvar i18nScientificColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"是\" : \"否\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"scientific\" : \"no scientific\")\n      }\n    }\n  }\n}\n\nvar i18nFinishInTrainColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"是\" : \"否\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"Finish In Train\" : \"Unfinished In Train\")\n      }\n    }\n  }\n}\n\nvar i18nPassedColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '<span>通过</span>' : '<span style=\"color:#FB5A5B\">未通过</span>')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? '<span>passed</span>' : '<span style=\"color:#FB5A5B\">failed</span>')\n      }\n    }\n  }\n}\n\nvar i18nNeedRepeatColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"需要复评\" : \"不需要复评\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"Need Repeat\" : \"No Need Repeat\")\n      }\n    }\n  }\n}\n\nvar i18nAddGradeColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"已加入成绩库\" : \"未加入成绩库\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"Add Grade\" : \"Not Add Grade\")\n      }\n    }\n  }\n}\n\nvar i18nSubmitColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? \"已提交\" : \"<span style='opacity:0.4'>未提交</span>\")\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? \"Submitted\" : \"<span style='opacity:0.4'>Not Submit</span>\")\n      }\n    }\n  }\n}\n\nvar i18nRetakeColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '<span style=\"color:red\">重修</span>' : '正常')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? '<span style=\"color:red\">Retake</span>' : 'Normal')\n      }\n    }\n  };\n}\n\n\nvar i18nPinnedColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '正选' : '<span style=\"color:red\">预选</span>')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? 'Pinned' : '<span style=\"color:red\">Preselected</span>')\n      }\n    }\n  };\n}\n\n\nvar i18nNeedAttendColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '听课' : '<span style=\"color:red\">免听</span>')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? 'NeedAttend' : '<span style=\"color:red\">NeedNotAttend</span>')\n      }\n    }\n  };\n}\n\n\nvar i18nNeedExamColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '考试' : '<span style=\"color:red\">免考</span>')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? 'NeedExam' : '<span style=\"color:red\">NeedNotExam</span>')\n      }\n    }\n  };\n}\n\nvar checkboxColumn = function (fieldName, checkboxName) {\n  var column = {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      return '<input type=\"checkbox\" name=\"' + checkboxName + '\" value=\"' + field.data + '\"/>';\n    }\n  }\n  return column;\n}\n\nvar linkColumn = function (fieldName, infoPermit, infoUrl, baseURI, $form) {\n  var column = {\n    \"data\": fieldName,\n    \"render\": function (field, row, allDataList, settings) {\n      if (infoPermit) {\n        var url = window.CONTEXT_PATH + infoUrl + row.data.id + \"?REDIRECT_URL=\" +\n            encodeURIComponent(baseURI + $form.getQueryString());\n        return '<a href=\"' + url + '\">' + field.data + '</a>';\n      } else {\n        return field.data;\n      }\n    }\n  }\n  return column;\n}\n\n// 多行文本展示\nvar multiLineTextColumn = function (fieldName) {\n  return {\n    data: fieldName,\n    render: function (field) {\n      return field.data == null ? \"\" : `<div class=\"br-text\">${field.data.replace(/(\\\\n)+|[\\r\\n]+/g, '<br/>')}</div>`;\n    },\n    wrapText: true,\n    autoHeight: true\n  }\n}\n\n\nvar multiLineHtmlColumn = function (fieldName) {\n  return {\n    data: fieldName,\n    render: function (field) {\n      return `<div class=\"br-text\">${field.data}</div>`;\n    },\n    wrapText: true,\n    autoHeight: true\n  }\n}\n\n// 保留多个空格\nvar preColumn = function (fieldName) {\n  return {\n    data: fieldName,\n    render: function (field) {\n      return `<span style=\"white-space:pre;\">${field.data}</span>`;\n    }\n  }\n}\n\nvar i18nEnrollModelColumn = function (fieldName) {\n  return {\n    data: fieldName,\n    render: function (field) {\n      if ('AUTO' == field.data) {\n        return window.LOCALE == 'zh' ? '自动录取' : 'AUTO';\n      }\n\n      if ('MANUAL' == field.data) {\n        return window.LOCALE == 'zh' ? '手动录取' : 'MANUAL';\n      }\n    }\n  }\n}\n\nvar i18nEnrollResultColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '已录取' : '未录取')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? 'Enrolled' : 'Not Enrolled')\n      }\n    }\n  }\n}\n\nvar i18nGeneratedColumn = function (fieldName) {\n  return {\n    \"data\": fieldName,\n    \"render\": function (field) {\n      if (window.LOCALE === 'zh') {\n        return field.data == null ? ' ' : (field.data ? '已生成' : '<span style=\"color:red\">未生成</span>')\n      }\n      if (window.LOCALE === 'en') {\n        return field.data == null ? ' ' : (field.data ? 'Generated' : '<span style=\"color:red\">Not Generate</span>')\n      }\n    }\n  }\n}\n\n/**\n * 审核状态渲染的值\n * @param fieldValue\n * @param defaultEmptyValue 如果是非空值 则 取这个 传入的值\n * @returns {string}\n */\nvar auditStateRenderValue = function (fieldValue, defaultEmptyValue) {\n  var auditStatusDom = '<input type=\"hidden\" class=\"auditStatus\" value=\"' + fieldValue + '\">';\n  if ('SUBMITTED' == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\" style=\"color:#333333\">已提交</span>' : '<span class=\"auditStatus\" style=\"color:#333333\">SUBMITTED</span>') + auditStatusDom;\n  } else if ('NOT_SUBMITTED' == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\" style=\"opacity:0.4; color:#666666\">未提交</span>' : '<span span class=\"auditStatus\" style=\"opacity:0.4; color:#666666\">NOT_SUBMITTED</span>') + auditStatusDom;\n  } else if ('IN_PROGRESS' == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\" style=\"color:#FFA543\">审核中</span>' : '<span class=\"auditStatus\" style=\"color:#FFA543\">IN_PROGRESS</span>') + auditStatusDom;\n  } else if ('ACCEPTED' == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\" style=\"color:#22A498\">通过</span>' : '<span class=\"auditStatus\" style=\"color:#22A498\">ACCEPTED</span>') + auditStatusDom\n        + '<input type=\"hidden\" class=\"accepted\" value=\"' + fieldValue + '\" />';\n  } else if ('REJECTED' == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\" style=\"color:#FB5A5B\">未通过</span>' : '<span class=\"auditStatus\" style=\"color:#FB5A5B\">REJECTED</span>') + auditStatusDom;\n  } else if ('CANCELLED' == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\" style=\"opacity:0.4; color:#666666\">已撤回</span>' : '<span class=\"auditStatus\" style=\"opacity:0.4;color:#666666\">CANCELLED</span>') + auditStatusDom;\n  } else if (\"RETURN_MODIFICATION\" == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\" style=\"color:#FB5A5B\">退回修改</span>' : '<span class=\"auditStatus\" style=\"color:#FB5A5B\">RETURN_MODIFICATION</span>') + auditStatusDom;\n  } else if ('CLOSE_FLOW' == fieldValue) {\n    return (window.LOCALE == 'zh' ? '<span class=\"auditStatus\">关闭流程</span>' : '<span class=\"auditStatus\">CLOSE_FLOW</span>') + auditSta