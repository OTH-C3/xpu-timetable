            "text": "+function ($) {\n  'use strict';\n\n  var TimeTable = function (element, options) {\n\n    this.options = options;\n\n    this.$el = $(element);\n\n    require.config({\n      baseUrl : window.CONTEXT_PATH + '/static/scheduletable/js',\n\n      paths: {\n        text : window.CONTEXT_PATH + '/static/eams-ui/js/text',\n        vue: './lib/vue.min',\n        ELEMENT: './lib/element-ui'\n      }\n    });\n\n    this.initLessons();\n    this.initCards();\n    this.initScheduleGroups();\n    this.initCommonOptions();\n    if (this.options.unDraggableTimeTable && this.options.semesterId) {\n      this.unDraggableTimeTable();\n    } else {\n      this.initHolidays();\n      this.getStartDateOfSemester();\n      this.arrangeSchedule();\n    }\n  }\n\n  TimeTable.VERSION = '0.0.1';\n\n  TimeTable.prototype.initCommonOptions = function() {\n    var _self = this;\n    require([\n      'common'\n    ], function (common) {\n      common.adminclassCoursetableMode = _self.options.adminclassCoursetableMode;\n      common.teacherCoursetableMode = _self.options.teacherCoursetableMode;\n      common.lessonUnitLimit = _self.options.lessonUnitLimit;\n      common.teachingUnitLimit = _self.options.teachingUnitLimit;\n      common.emptyCourseTypeMode = _self.options.emptyCourseTypeMode;\n      common.timeTableLayoutId = _self.options.timeSegmentLayout && _self.options.timeSegmentLayout.timeTableLayoutId ? _self.options.timeSegmentLayout.timeTableLayoutId : null;\n      common.limitLessonTypes = !_self.options.isLargeClass && _self.options.limitLessonTypes ? _self.options.limitLessonTypes : [];\n      common.timeTableLayoutId = _self.options.timeTableLayoutId;\n      common.specialAccount = _self.options.specialAccount || false;\n      common.unitOccupancyMode = _self.options.unitOccupancyMode || false;\n      common.unitAmounts = _self.options.unitAmounts || [];\n    });\n  }\n\n  TimeTable.prototype.initCards = function () {\n    var self = this;\n    require([\n      'models/card',\n      'collections/cards'\n    ], function (CardModel, cardList) {\n      var scheduleList = _.filter(self.options.schedules, function (sch) {\n        return !sch.practiceSchedule\n      })\n      _.each(scheduleList, function (sch) {\n        if ((sch.room !== undefined && sch.room !== null && sch.room.id !== null) || sch.customPlace !== null) {\n          sch.exists = true;\n        }\n      });\n      var cardMap = _.groupBy(scheduleList, function(schedule) {\n        return schedule.lessonId + ':' + schedule.scheduleGroupId + ':' +\n          schedule.startTime + ':' + schedule.endTime + ':' + schedule.weekday;\n      });\n      var cards = _.values(cardMap);\n\n      var lessonId2adminclassIds = {};\n      $.each(self.options.lessons, function (index, lesson) {\n        lessonId2adminclassIds[lesson.id] = lesson.adminclassIds;\n      });\n\n      var centralizeSchedule = _.groupBy(self.options.centralizeSchedules.bigLessonScheduleList, function (schedule) {\n        return schedule.startTime + ':' + schedule.endTime + ':' + schedule.weekDay;\n      });\n\n      _.each(cards, function(schedules) {\n        // 大课排课处理\n        if (self.options.isLargeClass && centralizeSchedule[schedules[0].startTime + ':' + schedules[0].endTime + ':' + schedules[0].weekday]) {\n          return;\n        } else {\n          // 存在相同周次只有教室不一样的重复数据，card应分开（如：一个任务周一一二节拖拽了两个card，只有教室不一样）\n          var weekIndexMap = _.groupBy(schedules, function (sch) {\n            return sch.personId + ':' + sch.teacherId + ':' + sch.weekIndex\n          })\n          var itemMaxLen = _.max(_.values(weekIndexMap), function (item) {\n            return item.length\n          })\n          if (itemMaxLen.length > 1) {\n            var cardItems = []\n            for (var key in weekIndexMap) {\n              if (cardItems.length < 1) {\n                _.each(weekIndexMap[key], function (sch){\n                  var room = ''\n                  if (sch.room && sch.room.id) {\n                    room = sch.room.id\n                  } else {\n                    room = sch.customPlace\n                  }\n                  cardItems.push({ rooms: room, schedules: [sch], weekIndexes: [sch.weekIndex]});\n                })\n              } else {\n                var itemMap =  _.groupBy(cardItems, function (item){\n                    return item.rooms\n                })\n                _.each(weekIndexMap[key], function (sch){\n                  var room = ''\n                  if (sch.room && sch.room.id) {\n                    room = sch.room.id\n                  } else {\n                    room = sch.customPlace\n                  }\n                  if (itemMap[room]) {\n                    itemMap[room][0].schedules.push(sch)\n                    itemMap[room][0].weekIndexes.push(sch.weekIndex)\n                  } else {\n                    // 判断没有当前周次的添加\n                    var currentItem\n                    var itemByWeekIndexMap = _.groupBy(cardItems, function (item) {\n                      return item.weekIndexes\n                    })\n                    for(var k in itemByWeekIndexMap) {\n                      if (k.indexOf(sch.weekIndex) === -1) {\n                        currentItem = itemByWeekIndexMap[k][0]\n                      }\n                    }\n                    if (currentItem) {\n                      currentItem.schedules.push(sch)\n                      currentItem.weekIndexes.push(sch.weekIndex)\n                    } else {\n                      cardItems.push({ rooms: room, schedules: [sch], weekIndexes: [sch.weekIndex]});\n                    }\n                  }\n                })\n              }\n            }\n            _.each(cardItems, function (card) {\n              var cardModel = new CardModel();\n              cardModel.initBySchedules(card.schedules);\n              cardModel.set(\"adminclassIds\", lessonId2adminclassIds[card.schedules[0].lessonId]);\n              cardModel.set(\"isChangeSchedules\", true);\n              cardList.add(cardModel);\n            })\n          } else {\n            var cardModel = new CardModel();\n            cardModel.initBySchedules(schedules);\n            cardModel.set(\"adminclassIds\", lessonId2adminclassIds[schedules[0].lessonId]);\n            cardModel.set(\"isChangeSchedules\", true);\n            cardList.add(cardModel);\n          }\n        }\n      });\n\n      var centralizeCard = _.groupBy(scheduleList, function(schedule) {\n        return schedule.startTime + ':' + schedule.endTime + ':' + schedule.weekday;\n      });\n      // 大课的card\n      if (self.options.isLargeClass) {\n        _.each(self.options.centralizeSchedules.bigLessonScheduleList, function (schedule) {\n          var cardModel = new CardModel();\n          cardModel.set('startTime', schedule.startTime);\n          cardModel.set('endTime', schedule.endTime);\n          cardModel.set('weekday', schedule.weekDay);\n          cardModel.set('lessonId', -1);\n          cardModel.set('scheduleGroupId', -1);\n          cardModel.set(\"isChangeSchedules\", true);\n\n          var centralizeSchedules = centralizeCard[schedule.startTime + ':' + schedule.endTime + ':' + schedule.weekDay];\n          if (centralizeSchedules) {\n\n            cardModel.set('periods', centralizeSchedules[0].periods);\n            _.each(centralizeSchedules, function(schedule) {\n              cardModel.get('schedules').add(schedule);\n              if (cardModel.get('weekIndexes').indexOf(schedule.weekIndex) == -1) {\n                cardModel.get('weekIndexes').push(schedule.weekIndex);\n              }\n            });\n          }\n          cardList.add(cardModel);\n        });\n      }\n      cardList.setWeekIndices();\n    });\n  }\n\n  TimeTable.prototype.initLessons = function() {\n    var self = this;\n    require([\n      'common',\n      'models/lesson',\n      'collections/lessons'\n    ], function (common, LessonModel, lessonList) {\n      if (self.options.isLargeClass) {\n        var lessonModel = new LessonModel(self.options.centralizeSchedules);\n        lessonModel.set('id', -1);\n        lessonModel.set('code', self.options.centralizeSchedules.name);\n        lessonModel.set('campusId', self.options.lessons[0].campusId);\n        lessonModel.set('campus', self.options.lessons[0].campus);\n        lessonModel.set('scheduleType', 'centralize');\n        lessonModel.set('showClearRoomBtn', self.options.showClearRoomBtn);\n        let requiredPeriodInfo = common.setLessonType(self.options.lessons || [], lessonModel.get('requiredPeriodInfo'))\n        lessonModel.set('requiredPeriodInfo', requiredPeriodInfo);\n        lessonList.add(lessonModel);\n      }\n\n      var practiceSchedulesMap = _.groupBy(self.options.schedules, function(schedule) {\n        schedule.roomId = schedule.room ? schedule.room.id : null\n        schedule.experimentId =  null\n        return schedule.lessonId + ':' + schedule.practiceSchedule;\n      });\n      let lessonId2AdminPracticeScheduleMap = self.options.lessonId2AdminPracticeScheduleMap\n      $.each(self.options.lessons, function() {\n        // 教学班排序\n        this.adminclasses = _.sortBy(this.adminclasses, 'nameZh');\n        var lessonModel = new LessonModel(this);\n        lessonModel.set('showClearRoomBtn', self.options.showClearRoomBtn);\n        if (practiceSchedulesMap[this.id + ':true'] && practiceSchedulesMap[this.id + ':true'].length > 0) {\n          lessonModel.set('practiceScheduleList', practiceSchedulesMap[this.id + ':true']);\n          common.practiceWeekOnlyMapData[this.id] = []\n          common.practiceWeekOnlyMapData[this.id].push(practiceSchedulesMap[this.id + ':true'])\n        }\n        if (lessonId2AdminPracticeScheduleMap[this.id] && lessonId2AdminPracticeScheduleMap[this.id].length > 0) {\n          lessonModel.set('practiceScheduleList', lessonId2AdminPracticeScheduleMap[this.id]);\n          common.practiceWeekMapData[this.id] = []\n          common.practiceWeekMapData[this.id].push(lessonId2AdminPracticeScheduleMap[this.id])\n        }\n        if (self.options.isLargeClass) {\n          lessonModel.set('scheduleType', 'decentralize');\n        }\n        lessonList.add(lessonModel);\n      });\n    });\n  }\n\n  TimeTable.prototype.initScheduleGroups = function() {\n    var self = this;\n    require([\n      'models/scheduleGroup',\n      'collections/scheduleGroups'\n    ], function (ScheduleGroupModel, scheduleGroups) {\n      _.each(self.options.scheduleGroups, function(group) {\n        var groupModel = new ScheduleGroupModel(group);\n        scheduleGroups.add(groupModel);\n      });\n\n      // 本地默认有个大课排课的排课组\n      if (self.options.isLargeClass) {\n        var groupModel = new ScheduleGroupModel({\n          actualPeriods: 0,\n          default: true,\n          id: -1,\n          lessonId: -1,\n          no: 0,\n          limitCount: self.options.centralizeSchedules.limitCount,\n          stdCount: self.options.centralizeSchedules.stdCount,\n        });\n        scheduleGroups.add(groupModel);\n      }\n    });\n  }\n\n  TimeTable.prototype.initHolidays = function() {\n    var self = this;\n    require([\n      'models/holiday',\n      'collections/holidays',\n      'services/mainService'\n    ], function (HolidayModel, holidays, MainService) {\n      _.each(MainService.getHoliday(self), function(holiday) {\n        var holidayModel = new HolidayModel(holiday);\n        holidays.add(holidayModel);\n      });\n    });\n  }\n\n  TimeTable.prototype.getStartDateOfSemester = function() {\n    var self = this;\n    require([\n      'common',\n      'services/mainService'\n    ], function (common, MainService) {\n      common.startDateOfSemester = MainService.getStartDateOfSemester(self);\n    });\n  }\n\n  TimeTable.prototype.arrangeSchedule = function() {\n    var self = this;\n    require([\n      'models/timeTable',\n      'views/windowView',\n      'common'\n    ], function (TimeTableModel, WindowView, common) {\n\n      common.bizTypeId = self.options.bizTypeId;\n      common.semesterId = self.options.semesterId;\n      common.isLargeClass = self.options.isLargeClass;\n      common.bigLessonId = self.options.centralizeSchedules.id;\n\n      var timeTable = new TimeTableModel(self.options.timeSegmentLayout);\n\n      new WindowView({\n        el: self.$el,\n        timeTable: timeTable,\n        weekdayList: self.options.weekdayList,\n        lessonId2AllowModifyCourseUnit:self.options.lessonId2AllowModifyCourseUnit\n      });\n    });\n  }\n\n  TimeTable.prototype.unDraggableTimeTable = function() {\n    this.$el.empty();\n    var self = this;\n    require([\n      'models/timeTable',\n      'views/timeTableView',\n      'collections/holidays',\n      'collections/weekdayColumns',\n      'collections/warnCards',\n      'common'\n    ], function (TimeTableModel, TimeTableView, holidays, weekdayColumns, warnCards, common) {\n\n      common.bizTypeId = self.options.bizTypeId;\n      common.semesterId = self.options.semesterId;\n\n      if (!common.units.length) {\n        common.units = self.options.timeSegmentLayout.units;\n        _.each(self.options.timeSegmentLayout.units, function (unit) {\n          common.startTimeList.push(unit.startTimeText);\n          common.endTimeList.push(unit.endTimeText);\n        });\n      }\n\n      var timeTable = new TimeTableModel(self.options.timeSegmentLayout);\n\n      var tableView = new TimeTableView({\n        timeTable: timeTable,\n        weekdayList: self.options.weekdayList,\n        parentEl: self.$el,\n        draggable: false,\n        courseTable: self.options.courseTable\n      });\n      tableView.render();\n    });\n  }\n\n  TimeTable.prototype.clearData = function() {\n    require([\n      'collections/lessons',\n      'collections/cards',\n      'collections/scheduleGroups',\n      'collections/holidays',\n      'collections/weekdayColumns',\n      'collections/warnCards',\n      'common'\n    ], function (lessons, cards, scheduleGroups, holidays, weekdayColumns, warnCards, common) {\n\n      common.bizTypeId = null;\n      common.semesterId = null;\n\n      lessons.reset();\n      cards.reset();\n      scheduleGroups.reset();\n      holidays.reset();\n      weekdayColumns.reset();\n      warnCards.reset();\n    });\n  }\n\n  /**\n   * destroy semiAutoTable\n   */\n  TimeTable.prototype.destroy = function () {\n\n    this.clearData();\n    this.$el.removeData('timeTable');\n    this.$el.empty();\n\n  }\n\n  // TimeTable PLUGIN DEFINITION\n  // =======================\n\n  function Plugin(option) {\n    var args = arguments;\n    var ret;\n    this.each(function () {\n      var $this = $(this);\n      var data = $this.data('timeTable');\n\n      if (!data) {\n        var options = $.extend(true, {}, $.fn.timeTable.defaults, typeof option == 'object' && option);\n        $this.data('timeTable', (data = new TimeTable(this, options)))\n      }\n\n      if (typeof option == 'string') {\n        if (args.length == 1) {\n          var _ret = data[option].call(data);\n          if (typeof _ret != 'undefined') {\n            ret = _ret;\n          }\n        } else {\n          var _ret = data[option].apply(data, Array.prototype.slice.call(args, 1));\n          if (typeof _ret != 'undefined') {\n            ret = _ret;\n          }\n        }\n      }\n    })\n\n    if (typeof ret != 'undefined') {\n      return ret;\n    }\n    return this;\n\n  }\n\n  var old = $.fn.timeTable\n\n  $.fn.timeTable = Plugin\n  $.fn.timeTable.Constructor = TimeTable\n  $.fn.timeTable.defaults = {\n\n    bizTypeId: null,\n\n    semesterId: null,\n\n    timeSegmentLayout: null,\n\n    lessons: [],\n\n    schedules: [],\n\n    scheduleGroups: [],\n\n    weekdayList: [],\n\n    //只显示课表\n    unDraggableTimeTable: false,\n\n    // 是否是大课排课\n    isLargeClass: false,\n\n    // 大课排课集中排课页面\n    centralizeSchedules: [],\n\n    // 大课排课分散排课页面\n    decentralizeSchedules: [],\n\n    // 是否显示清除教室按钮\n    showClearRoomBtn: false\n\n  };\n\n  // TimeTable NO CONFLICT\n  // =================\n  $.fn.timeTable.noConflict = function () {\n\n    $.fn.timeTable = old;\n    return this;\n\n  }\n\n}(jQuery);\n"
