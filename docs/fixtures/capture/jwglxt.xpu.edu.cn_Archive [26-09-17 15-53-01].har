            "text": "function getData(baseURI, data){\n  var result = {};\n\n  $.ajax({\n    url: window.CONTEXT_PATH + baseURI + '/get-all-course-data',\n    type: 'get',\n    async: false,\n    data: data,\n    success: function (res) {\n      result = res;\n    }\n  });\n\n  return result;\n}\n\nfunction _value(obj, path) {\n  if (!obj) {\n    return '';\n  }\n\n  if (!path) {\n    return '';\n  }\n\n  var pathArr = path.split(\".\");\n  var tmp = obj;\n  _.each(pathArr, function (pathItem) {\n    if (!tmp && tmp !== 0) {\n      return false;\n    }\n    if (!tmp.hasOwnProperty(pathItem)) {\n      tmp = '无';\n    }\n    tmp = tmp[pathItem];\n  });\n\n  if (!tmp && tmp !== 0) {\n    tmp = '无'\n  }\n\n  return tmp;\n}\n\nfunction getTimeText(time) {\n  var hours = parseInt(time/100);\n  var minutes = time%100;\n  return hours + ':' + (minutes == 0 ? '00' : (parseInt(minutes/10) == 0 ? '0'+(minutes) : ''+(minutes)));\n}\n\n//主修、重修、免听\nfunction organizeTagInfo(lesson2CultivateTypeMap, lessonId2Retake, notAttendLessonIds){\n  lesson2CultivateTypeMap = lesson2CultivateTypeMap ? lesson2CultivateTypeMap : {};\n  lessonId2Retake = lessonId2Retake ? lessonId2Retake : {};\n  notAttendLessonIds = notAttendLessonIds ? notAttendLessonIds : [];\n\n  var tagInfo = {\n    cultivateType: [],\n    retake: [],\n    notAttend: []\n  };\n\n  for (const key in lesson2CultivateTypeMap) {\n    if (Object.hasOwnProperty.call(lesson2CultivateTypeMap, key)) {\n      const lesson = lesson2CultivateTypeMap[key];\n      var nameZh = $.trim(lesson.nameZh);\n      if(nameZh && nameZh !== '主修'){\n        tagInfo.cultivateType.push({\n          lessonId: Number(key),\n          nameZh: nameZh\n        });\n      }\n    }\n  }\n\n  for (const key in lessonId2Retake) {\n    if (Object.hasOwnProperty.call(lessonId2Retake, key)) {\n      if(lessonId2Retake[key]){\n        tagInfo.retake.push(Number(key));\n      }\n    }\n  }\n\n  notAttendLessonIds.forEach(function(lessonId){\n    tagInfo.notAttend.push(Number(lessonId))\n  })\n\n  return tagInfo;\n}\n\nfunction getTagObj(lessonId, tagInfo) {\n  var tagStr = '<div class=\"tag-info\">';\n  var flag = false;\n  var noAttendFlag = false;\n  var retakeCountFlag = false;\n\n  tagInfo = tagInfo ? tagInfo : {};\n\n  if (tagInfo.cultivateType) {\n    tagInfo.cultivateType.forEach(function (type) {\n      if (type.lessonId === lessonId) {\n        tagStr += '<span>' + type.nameZh + '</span>';\n        flag = true;\n      }\n    })\n  }\n\n  if (tagInfo.retake && tagInfo.retake.includes(lessonId)) {\n    tagStr += '<span>重修</span>';\n    retakeCountFlag = true;\n  }\n\n  if(tagInfo.notAttend && tagInfo.notAttend.includes(lessonId)){\n    tagStr += '<span>免听</span>';\n    noAttendFlag = true;\n  }\n\n\n  if (flag || retakeCountFlag || noAttendFlag) {\n    tagStr += '</div>'\n  } else {\n    tagStr = '';\n  }\n\n  return {\n    tagStr: tagStr,\n    noAttend: noAttendFlag,\n    retake: retakeCountFlag\n  };\n}\n\nfunction fillSemester($tableContent, semesters, lessons, lessonTagData, type,getClassListAuth, showToggleBtn, isAllSemesters=true, noPublishLessonIds=[]) {\n  if ((!lessons || !lessons.length) && isAllSemesters) {\n    return false;\n  }\n\n  var toggleBtn = showToggleBtn ? true : false;\n  var tableObj = getTableEle(lessons, type, lessonTagData,getClassListAuth, noPublishLessonIds);\n  var semesterBox = `<div class=\"course-box\">\n      <ul class=\"clearfix semester-bar\">\n        <li class=\"pull-left\">${semesters.nameZh}</li>\n        <li class=\"pull-left\">\n          总学分：<span>${tableObj.totalCredits}</span>\n         ${lessonTagData.totalRetakeCredits ? ' <span>(重修学分：' + lessonTagData.totalRetakeCredits + '）</span>' : ''}\n        </li>\n        ${toggleBtn ? '<li class=\"toggle-btn pull-right text-primary\">收起更多</li>': ''}\n      </ul>\n      ${tableObj.tableEle}\n    </div>`;\n\n  $('#table-content').append(semesterBox);\n  $('[data-toggle=\"tooltip\"]').tooltip();\n  if(toggleBtn){\n    toggleBtnControl($tableContent);\n  }\n}\n\nfunction getLessonType(currentLesson, currentBizTypeId){\n  var currentLessonType = '';\n  if (currentLesson && currentLesson.bizType && currentLesson.bizType.id !== currentBizTypeId) {\n    currentLessonType = '&nbsp;[' + currentLesson.bizType.nameZh + ']';\n  }\n\n  return currentLessonType;\n}\n\nfunction getTableEle(lessons, type, lessonTagData,getClassListAuth, noPublishLessonIds){\n  var lesson2CultivateTypeMap = lessonTagData.lesson2CultivateTypeMap;\n  var lessonId2Retake = lessonTagData.lessonId2Retake;\n  var notAttendLessonIds = lessonTagData.notAttendLessonIds;\n\n  var controlFlag = type === 'teacher' ? true : false;\n  var showTag = type === 'student' ? true : false;\n  var showLessonType = type === 'room' ? true : false;\n  var totalCredits = 0;\n  var tagInfo = {};\n\n  var tr = '';\n  if (lessons && lessons.length > 0) {\n    var sortedLessons = _.sortBy(lessons, function (lesson) {\n      return _value(lesson2CultivateTypeMap, lesson.id + '.nameZh') + _value(lesson, 'course.nameZh');\n    });\n\n    if (showTag) {\n      tagInfo = organizeTagInfo(lesson2CultivateTypeMap, lessonId2Retake, notAttendLessonIds);\n    }\n\n    sortedLessons.forEach(function (lesson) {\n      var tagObj = {};\n      var remark = _value(lesson, 'remark');\n\n      if (showTag) {\n        tagObj = getTagObj(lesson.id, tagInfo);\n      }\n\n      if (controlFlag) {\n        tagObj.tagStr = lesson.bizType.nameZh == '本科' ? '' : `<div class=\"tag-info\"><span>${lesson.bizType.nameZh}</span></div>`;\n      }\n\n      var compulsorys = [];\n      totalCredits += (lesson.course.credits ? lesson.course.credits : 0);\n\n      $.each(lesson.compulsorys, function (index, item) {\n        if (item == 'COMPULSORY') {\n          compulsorys.push(\"必修\")\n        } else if (item == 'ELECTIVE') {\n          compulsorys.push(\"选修\")\n        }\n      });\n      compulsorys = compulsorys.join(',');\n      let datePlacePerson = lesson.scheduleText.dateTimePlacePersonText.textZh != null ? _value(lesson, 'scheduleText.dateTimePlacePersonText.textZh').replace(/\\n/g, '<br/>') : _value(lesson, \"teacherAssignmentString\");\n      tr += ` <tr data-courseName=\"${_value(lesson, 'course.nameZh')}\" data-courseCode=\"${_value(lesson, 'course.code')}\">\n            <td>\n              <div class=\"title-box\" data-lessonId=\"${lesson.id}\">\n                <h5>\n                  ${_value(lesson, 'course.nameZh')}\n                  ${showLessonType ? getLessonType(lesson, lessonTagData.currentBizTypeId) : ''}\n                </h5>\n                <sup class=\"minor-courses\">${lesson.minorCourse && lesson.minorCourse.nameZh ? lesson.minorCourse.nameZh : ''}</sup>\n                ${(showTag || controlFlag) && tagObj.tagStr ? tagObj.tagStr : ''}\n              </div>\n              <ul class=\"clearfix\">\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"课程代码\">${_value(lesson, 'course.code')}</li>\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"开课部门\">${_value(lesson, 'openDepartment.nameZh')}</li>\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"课程类别\">${_value(lesson, 'courseType.nameZh')}</li>\n              </ul>\n              <ul class=\"clearfix\">\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"学分\">${_value(lesson, 'course.credits')}学分</li>\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"学时\">${_value(lesson, 'requiredPeriodInfo.total')}学时</li>\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"课程性质\">${_value(lesson, 'courseProperty.nameZh') === '无' ? '无' : _value(lesson, 'courseProperty.nameZh')}</li>\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"是否必修\">${compulsorys}</li>\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"授课语言\">${_value(lesson, 'teachLang.nameZh')}</li>\n                <li data-toggle=\"tooltip\" data-placement=\"top\" title=\"考核方式\">${_value(lesson, 'examMode.nameZh')}</li>\n              </ul>\n              ${remark !== '无' ? '<p class=\"remark\" data-toggle=\"tooltip\" data-placement=\"top\" title=\"'+ remark +'\">备注：' + remark + '</p>' : ''}\n            </td>\n            <td>\n              <p class=\"class-code\">${_value(lesson, 'code')}</p>\n              <p class=\"class-name\">${_value(lesson, 'nameZh')}</p>\n            </td>\n            <td>\n             ${ noPublishLessonIds.includes(lesson.id) ? '排课未发布' : (datePlacePerson == '无' ? '无排课数据' : datePlacePerson) }\n            </td>\n            <td>\n              <p>实际：${_value(lesson, 'stdCount')}</p>\n              <p>上限：${_value(lesson, 'limitCount')}</p>\n              ${tagObj.retake ? '<p>重修：' + lesson.retakeCount + '</p>' : ''}\n              ${tagObj.noAttend ? '<p>免听：' + lesson.noAttendCount + '</p>' : ''}\n            </td>\n            ${controlFlag & getClassListAuth ? '<td><button class=\"btn btn-primary btn-roll-call\" data-lessonId=\"' + lesson.id + '\" data-semesterId=\"' + (lesson.semester ? lesson.semester.id : '') + '\">点名册</button></td>' : ''}\n          </tr>`;\n    });\n\n  } else {\n    var emptySrc = window.CONTEXT_PATH + '/static/scheduletable/img/no-data.png';\n\n    tr = `<tr>\n      <td colSpan=\"${controlFlag ? 5 : 4}\" class=\"text-center\">\n        <img src=\"${emptySrc}\" alt=\"暂无相关数据\" style=\"width: 200px\"/>\n        <div>无数据</div>\n      </td>\n    </tr>`;\n  }\n\n  var table = ` \n        <table class=\"table course-table\">\n            <thead>\n              <tr>\n                <th width=\"32%\">课程信息</th>\n                <th width=\"24%\">教学班</th>\n                <th width=\"28%\">时间地点人员</th>\n                <th width=\"8%\">人数</th>\n                ${controlFlag ? '<th width=\"8%\"></th>': ''}\n              </tr>\n            </thead>\n            <tbody>\n              ${tr}\n            </tbody>\n        </table>`;\n\n\n  return {\n    tableEle: table,\n    totalCredits: totalCredits\n  };\n}\n\nfunction toggleBtnControl($tableContent){\n  $tableContent.find('.toggle-btn').unbind('click').on('click',function(){\n    var $this = $(this);\n    var $courseTable = $this.closest('.course-box').find('.course-table');\n    var flag = $.trim($this.text()) === '收起更多' ?  true : false;\n    $this.text(flag ? '展开更多' : '收起更多')\n    $courseTable.toggleClass('hide', flag);\n  });\n}\n\nfunction searchCourse($tableContent, val){\n  $tableContent.find('.course-box .course-table tbody tr').each(function (){\n    var $this = $(this);\n    var courseName = $this.attr('data-courseName');\n    var courseCode = $this.attr('data-courseCode');\n    courseName = courseName ? courseName : '';\n    courseCode = courseCode ? courseCode : '';\n\n    if(val === '' ||  courseName.includes(val) || courseCode.includes(val)){\n      $this.show();\n    }else{\n      $this.hide();\n    }\n  })\n}\n\nfunction debounce(fn,delay){\n  var time = null;\n  return function (e){\n    if(time){\n      clearTimeout(time);\n    }\n\n    time = setTimeout(() => {\n      fn.call(this,arguments);\n    },delay);\n  }\n}\n\nfunction searchControl($parent, $tableContent){\n  $parent.find('#search').on('input', debounce(function (){\n    searchCourse($tableContent, $(this).val())\n  },500));\n}\n\nfunction getDatum(datumData){\n  var result ;\n  $.ajax({\n    url: window.CONTEXT_PATH + \"/ws/schedule-table/datum\",\n    type: 'post',\n    contentType: 'application/json',\n    async: false,\n    data: JSON.stringify(datumData),\n    success: function (res) {\n      result = res;\n    }\n  });\n\n  return result;\n}\n\n//填充课程信息弹框中的内容\nfunction showSchedules(lesson, datumData, noPublishLessonIds=[]) {\n  var weekdayList = ['星期一', '星期二', '星期三', '星期四', '星期五', '星期六', '星期日'];\n  var schedules = [];\n  $('#info-content li:eq(0) a').tab('show');\n\n  var res  = getDatum(datumData);\n  schedules = res.result.scheduleList;\n\n  var compulsorys = [];\n  $.each(lesson.compulsorys, function (index, item) {\n    if (item == 'COMPULSORY') {\n      compulsorys.push(\"必修\")\n    } else if (item == 'ELECTIVE') {\n      compulsorys.push(\"选修\")\n    }\n  });\n  compulsorys = compulsorys.join(',');\n\n  var courseLevelRequireList = [];\n  if (lesson.courseLevelRequireList.length > 0) {\n    $.each(lesson.courseLevelRequireList, function (index, item) {\n      $.each(item.courseLevelList, function (j, item) {\n        if (index != 0 && j == 0) {\n          courseLevelRequireList.push(\";</br>\" + item.nameZh + \"(分组:\" + item.group + \" 等级值:\" + item.level + \") \");\n        } else {\n          courseLevelRequireList.push(item.nameZh + \"(分组:\" + item.group + \" 等级值:\" + item.level + \") \");\n        }\n      });\n    });\n  }\n  courseLevelRequireList = courseLevelRequireList.length == 0 ? \"\" : courseLevelRequireList.join(\",\").replace(\",;\", \";\");\n\n  var preCourse = [];\n  if (lesson.preCourses.length > 0) {\n    $.each(lesson.preCourses, function (index, item) {\n      if (index != 0) {\n        preCourse.push(\",\" + item.nameZh);\n      } else {\n        preCourse.push(item.nameZh);\n      }\n    });\n  }\n  preCourse = preCourse.length == 0 ? \"\" : preCourse.join(\",\").replace(\",,\", \",\");\n\n\n  var $tbody = '<tbody><tr>' +\n      '<td>所属业务类型</td>' +\n      '<td>' + _value(lesson, 'bizType.nameZh') + '</td>' +\n      '<td>所属学期</td>' +\n      '<td>' + _value(lesson, 'semester.nameZh') + '</td>' +\n      '</tr>'+\n      '<tr>' +\n      '<td>课程代码</td>' +\n      '<td>'+_value(lesson,'course.code')+'</td>' +\n      '<td>课程名称</td>' +\n      '<td>' + _value(lesson, 'course.nameZh') + '</td>' +\n      '</tr>'+\n      '<tr>' +\n      '<td>教学班代码</td>' +\n      '<td>' + _value(lesson, 'code') + '</td>' +\n      '<td>学分</td>' +\n      '<td>' + _value(lesson, 'course.credits') + '</td>' +\n      '</tr>'+\n      '<tr>' +\n      '<td >教学班名称</td>' +\n      '<td colspan=\"3\" style=\"word-break: break-all;\">'+_value(lesson,'nameZh')+'</td>' +\n      '</tr>'+\n      '<tr>' +\n      '<td>课程类别</td>' +\n      '<td>' + _value(lesson, 'courseType.nameZh') + '</td>' +\n      '<td>开课部门</td>' +\n      '<td>' + _value(lesson, 'openDepartment.nameZh') + '</td>' +\n      '</tr>' +\n      '<tr>' +\n      '<td>考核方式</td>' +\n      '<td>' + _value(lesson, 'examMode.nameZh') + '</td>' +\n      '<td>授课校区</td>' +\n      '<td>' + _value(lesson, 'campus.nameZh') + '</td>' +\n      '</tr>'+\n      '<tr>' +\n      '<td>授课语言</td>' +\n      '<td>' + _value(lesson, 'teachLang.nameZh') + '</td>' +\n      '<td>先修课程</td>' +\n      '<td>' + (preCourse ? preCourse : '无') + '</td>' +\n      '</tr>' +\n      '<tr>' +\n      '<td>任务类型</td>' +\n      '<td>'+_value(lesson,'lessonKindZh')+'</td>' +\n      '<td>是否必修</td>' +\n      '<td>' + (compulsorys ? compulsorys : '无') + '</td>' +\n      '</tr>' +\n      '<tr>' +\n      '<td>课程等级要求</td>' +\n      '<td>'+(courseLevelRequireList ? courseLevelRequireList : '无')+'</td>' +\n      '<td>要求总课时</td>' +\n      '<td>' + _value(lesson, 'requiredPeriodInfo.total') + '</td>' +\n      '</tr>' +\n      '<tr>' +\n      '<td>要求周数</td>' +\n      '<td>' + _value(lesson, 'requiredPeriodInfo.weeks') + '</td>' +\n      '<td>要求周课时</td>' +\n      '<td>' + _value(lesson, 'requiredPeriodInfo.periodsPerWeek') + '</td>' +\n      '</tr>'+\n      '<tr>' +\n      '<td>已安排总课时</td>' +\n      '<td>'+_value(lesson,'actualPeriods')+'</td>' +\n      '<td>选课上限</td>' +\n      '<td>' +_value(lesson, 'limitCount')+  '</td>' +\n      '</tr>'+\n      '<tr>' +\n      '<td>已选学生数</td>' +\n      '<td>'+_value(lesson,'stdCount')+'</td>' +\n      '<td>备注</td>' +\n      '<td>'+_value(lesson,'remark')+'</td>' +\n      '</tr></tbody>';\n\n  $(\"#base\").empty().append($tbody);\n\n  var new_schedules = [];\n  $.each(schedules, function () {\n    if (this.lessonId != lesson.id) {\n      return;\n    }\n    new_schedules.push(this);\n  });\n\n  new_schedules.sort(function (a, b) {\n    return a.date.localeCompare(b.date)\n  });\n\n  var trStr = '';\n  if(new_schedules.length && !noPublishLessonIds.includes(lesson.id)){\n    $.each(new_schedules, function () {\n      trStr += \"<tr>\" +\n          \"<td>\" + this.date + \"</td>\" +\n          \"<td>\" + (this.room ? (this.room.building.campus.nameZh + \" \" + this.room.nameZh) : '') + \"</td>\"+\n          \"<td>\" + (this.personName ? this.personName : '') + \"</td>\" +\n          \"<td>\" + weekdayList[this.weekday - 1] + \"</td>\" +\n          \"<td>\" + getTimeText(this.startTime) + \"</td>\" +\n          \"<td>\" + getTimeText(this.endTime) + \"</td>\"+\n          \"<td>\" + (this.periods ? this.periods : '') + \"</td>\" +\n          \"</tr>\";\n    });\n  }else {\n    var emptySrc = window.CONTEXT_PATH + '/static/scheduletable/img/no-data.png';\n    trStr = `<tr>\n                <td colspan=\"7\" class=\"text-center\">\n                  <img src=\"${emptySrc}\" alt=\"暂无相关数据\" style=\"width: 200px\"/>\n                   <div>无数据</div>\n                </td>\n            </tr>`;\n  }\n\n  $(\"#schedules\").find('tbody').empty().append(trStr);\n\n  $(\"#schedules-modal\").modal('show');\n};\n\n\n"
          },
          "redirectURL": "",
          "headersSize": 0,
          "bodySize": 4596
        },
