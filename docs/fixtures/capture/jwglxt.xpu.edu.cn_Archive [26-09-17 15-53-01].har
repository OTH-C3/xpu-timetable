          "content": {
            "mimeType": "application/javascript",
            "size": 1767,
            "text": "/**\n * 获取文件参数\n * @param business 业务类型\n * @returns {{}}\n */\nfunction getFileParamByBusiness(business) {\n  var url = window.CONTEXT_PATH + '/ws/file-param/get-by-business';\n  var fileParam = {};\n  $.post({\n    url:url,\n    data: {\n      business: business\n    },\n    async: false,\n    success: function (res) {\n      var allowedFileExtensions = [];\n      if(res.allowedFileExtensions.length > 0){\n        for(var i = 0; i < res.allowedFileExtensions.length; i++) {\n          allowedFileExtensions.push( res.allowedFileExtensions[i]);\n        }\n      }\n      fileParam['allowedFileExtensions'] = allowedFileExtensions;\n      fileParam['maxFileSize'] = res.maxFileSize;\n      fileParam['maxFileCount'] = res.maxFileCount;\n    }\n  });\n  var fileInputOptions = {};\n  fileInputOptions['showUpload'] = false;\n  fileInputOptions['showPreview'] = false;\n  fileInputOptions['previewFileType'] = 'any';\n\n  fileInputOptions['maxFileSize'] = fileParam.maxFileSize;\n  fileInputOptions['maxFileCount'] = fileParam.maxFileCount;\n  fileInputOptions['allowedFileExtensions'] = [];\n  var fileSize = fileParam.maxFileSize/1024;\n  var fileAllowedFileExtensions = \"\";\n  if(fileParam.allowedFileExtensions && fileParam.allowedFileExtensions.length > 0){\n    fileInputOptions['allowedFileExtensions'] = fileParam.allowedFileExtensions;\n    fileAllowedFileExtensions = fileParam.allowedFileExtensions.join(\",\");\n  }\n  // 文件提示相关语句\n  fileInputOptions['tipFileSize'] = fileSize;\n  fileInputOptions['tipAllowedFileExtensions'] = fileAllowedFileExtensions;\n  return fileInputOptions;\n}\n\n/**\n * 初始化相关的操作\n * @param business\n * @param $fileInfo fileInput 元素\n * @param $fileInfoTip fileInput 提示语元素\n * @param otherFileOptions 其他初始化相关参数\n *          override: 是否覆盖原来的属性\n *          manualInit: 是否自动初始化 , true 则手动\n *          uploadExtraData\n *          showRemove     展示删除\n *          initialPreview 文件名回显\n * @returns {{}}\n */\nfunction initFileParamByBusiness(business, $fileInfo, $fileInfoTip,otherFileOptions) {\n  var fileInputOptions;\n  var autoInit = true;\n  if(!!otherFileOptions && Object.keys(otherFileOptions).length){\n    fileInputOptions = otherFileOptions\n    autoInit = !otherFileOptions.manualInit;\n  }else{\n    fileInputOptions = getFileParamByBusiness(business);\n  }\n  //是否自动初始化\n  if($fileInfo.length > 0 && autoInit){\n    $fileInfo.fileinput('destroy');\n    $fileInfo.fileinput(fileInputOptions);\n  }\n  //文件参数 提示语\n  var fileSize = fileInputOptions['tipFileSize'];\n  var fileCount = fileInputOptions['maxFileCount'];\n  var fileAllowedFileExtensions = fileInputOptions['tipAllowedFileExtensions'];\n  if($fileInfoTip.length > 0){\n    var tipsHtml = \"最多可上传<span>\" + fileCount + \"</span>个,\"\n        + \"不大于<span>\" + fileSize + \"</span>MB,\"\n        + \"支持格式:<span>\" + (!!fileAllowedFileExtensions ? fileAllowedFileExtensions : \"不限\") + \"</span>\";\n    $fileInfoTip.html(tipsHtml);\n  }\n  return fileInputOptions;\n}\n\n/**\n * 文件回填\n * 文件上传之后，文件参数配置被修改，引发修改时文件回填格式、大小错误问题\n * fileInfo 已经上传文件信息\n * businessOnFileParam 业务类型\n * $fileInfo 目标输入input框\n * $fileTips 文件要求提示标签\n * $target 用于定位哪一个输入\n */\n\nfunction backfillFile(fileInfo, businessOnFileParam, $fileInfo = $(\"#fileInfo\"), $fileTips = $(\"#fileTips\"), $target = $('.file-input').parent()){\n  var fileData = getFileParamByBusiness(businessOnFileParam);\n\n  if(fileInfo !== null && fileInfo){\n    if ((fileInfo.bytes/1024) > fileData.maxFileSize ||\n        !fileData.allowedFileExtensions.includes(fileInfo.name.split(\".\")[fileInfo.name.split(\".\").length-1])\n    ){\n      fileData['initialCaption'] = fileInfo.name;\n      fileData['initialPreview'] = [\"<span>\" + fileInfo.name + \"</span>\"];\n      fileData['showRemove'] = true;\n      initFileParamByBusiness(businessOnFileParam, $fileInfo,$fileTips,fileData);\n\n      var $fileInput = $target.find(\".file-input\");\n      var $fileName = $fileInput.find(\".file-caption-name\") || $(\".file-caption-name\");\n      var $icon = $fileInput.find(\".file-caption-icon\") || $(\".file-caption-icon\");\n      $fileName.val((fileInfo.bytes/1024) > fileData.maxFileSize ? '大小超过限制' : '格式不正确');\n      $icon.html(`<span class=\"text-danger\"><i class=\"glyphicon glyphicon-exclamation-sign\"></i> </span>`)\n      $fileInput.closest(\".form-group\").addClass('has-error');\n    }else{\n      fileData['uploadExtraData'] = {\"id\": fileInfo.id, \"fileName\": fileInfo.name};\n      fileData['initialCaption'] = fileInfo.name;\n      fileData['previewFileIcon'] = \"<i class='glyphicon glyphicon-file'></i>\";\n      fileData['initialPreview'] = [\"<span>\" + fileInfo.name + \"</span>\"];\n      fileData['showRemove'] = true;\n      initFileParamByBusiness(businessOnFileParam, $fileInfo,$fileTips,fileData)\n    }\n\n    $fileInfo.on(\"filecleared\", function () {\n      $(\"input[name='moveFile']\").val(true);\n      $fileInfo.closest(\".form-group\").find(\".removeFile\").val(true)\n    });\n\n  }else{\n    initFileParamByBusiness(businessOnFileParam, $fileInfo,$fileTips,fileData)\n  }\n\n}\n\n\n\n"
          },
          "redirectURL": "",
          "headersSize": 0,
          "bodySize": 1767
        },
