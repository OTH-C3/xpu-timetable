d', '该结果未发布，不能取消发布！', ['已发布', 'published', true, 1]);\n\n  MenuButton.prototype.hasRelation = function ({key, ids, url}) {\n    var hasRelation = false;\n    if (!url && !key) {\n      console.error(`'key' must have when 'url' does not have it.`);\n      return false;\n    }\n    if (!_.isArray(ids)) {\n      console.error('ids must be Array.');\n      return false;\n    }\n    url = url || '/ws/common/delete/has-relation';\n    $.ajax({\n      url: window.CONTEXT_PATH + url,\n      type: 'post',\n      async: false,\n      contentType: 'application/json',\n      data: JSON.stringify({key, ids}),\n      dataType: 'json',\n      success: function (res) {\n        if (res.result) {\n          hasRelation = true;\n          var message = '存在以下关联数据，不能删除<br/>';\n          $.each(res.message, function (index, item) {\n            message += item + '<br/>';\n          });\n          bootbox.alert(message);\n        }\n      }\n    });\n    return hasRelation;\n  }\n\n  /**\n   * 用于将按钮组转成下拉按钮，解决因按钮权限导致下拉按钮渲染异常的问题\n   * e.g. let menus = [], curd = []\n   * if(addPermission) curd.push(addBtnObj)\n   * if(editPermission) curd.push(editBtnObj)\n   * if(infoPermission) curd.push(infoBtnObj)\n   * menus.push(MenuButton.dropdownFormat(curd))\n   *\n   * @param arr\n   * @returns Array\n   */\n\n  MenuButton.prototype.dropdownFormat = function (arr) {\n    if (!type || !arr || !arr.length) {\n      return arr\n    }\n\n    const _temp = arr.splice(0, 1)\n    _temp[0].dropdowns = arr\n    return _temp\n  }\n\n  window.MenuButton = new MenuButton()\n  return null;\n}(jQuery))\n\n\n// var checkExcludedAccepted = checkFactory('auditState','只能对已通过的进行操作',['ACCEPTED','通过'],false);\n//\n// var checkExcludedCancelled = checkFactory('auditState','只能对已撤回的数据进行操作',['CANCELLED','取消'],false);\n//\n// var checkExcludedSubmitted = checkFactory('auditState','只能对已提交的数据进行操作',['SUBMITTED','已提交'],false);\n\n\n"
