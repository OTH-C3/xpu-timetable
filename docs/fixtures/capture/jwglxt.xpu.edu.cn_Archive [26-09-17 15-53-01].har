          "content": {
            "mimeType": "application/javascript",
            "size": 634,
            "text": "/**\n * Created by wx on 17-6-5.\n */\n\nvar newCourseTableConfig = {\n\n  config: [\n    {\n      nameZh:\"上午\",\n      nameEn:\"MORNING\",\n      unitGroup:[[1,2],[3,4]]\n    },\n    {\n      nameZh:\"下午\",\n      nameEn:\"AFTERNOON\",\n      unitGroup:[[5,6],[7,8]]\n    },\n    {\n      nameZh:\"晚上\",\n      nameEn:\"EVENING\",\n      unitGroup:[[9,10,11]]\n    }\n  ],\n  tableRemark: {\n    \"room\" : \"因选课是动态的，本教室课表仅供参考，准确信息请以网上公布为准\",\n    \"teacher\": \"因选课是动态的，本教师课表仅供参考，准确信息请以网上公布为准\",\n    \"adminclass\": \"\",\n    \"student\": \"\"\n  }\n\n};\n"
