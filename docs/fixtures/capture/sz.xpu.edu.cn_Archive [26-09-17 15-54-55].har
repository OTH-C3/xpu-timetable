          "content": {
            "mimeType": "text/html; charset=UTF-8",
            "size": 6279,
            "text": "<!DOCTYPE html>\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"zh\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>教育数字化应用服务平台</title>\r\n    <link rel=\"stylesheet\" href=\"https://sz.xpu.edu.cn/auth2/css/login.css\">\r\n    <link rel=\"stylesheet\" href=\"https://sz.xpu.edu.cn/auth2/js/layer/skin/layer.css\">\r\n    <script src=\"https://sz.xpu.edu.cn/auth2/js/jquery.js\" type=\"text/javascript\"></script>\r\n    <script src=\"https://sz.xpu.edu.cn/auth2/js/layer/layer.js\" type=\"text/javascript\"></script>\r\n    <script src=\"https://sz.xpu.edu.cn/auth2/js/ase.js\" type=\"text/javascript\"></script>\r\n    <script src=\"https://sz.xpu.edu.cn/auth2/js/crypto-js.js\" type=\"text/javascript\"></script>\r\n    <script src=\"https://sz.xpu.edu.cn/auth2/js/verify.js\" type=\"text/javascript\"></script>\r\n    <script src=\"https://sz.xpu.edu.cn/auth2/js/Base64.js\" type=\"text/javascript\"></script>\r\n    <link rel=\"stylesheet\" href=\"https://sz.xpu.edu.cn/auth2/css/verify.css\">\r\n    <link rel=\"stylesheet\" href=\"https://sz.xpu.edu.cn/auth2/css/index.css\">\r\n</head>\r\n<body>\r\n<div class=\"wrap\">\r\n    <div class=\"box\">\r\n        <div class=\"header\">\r\n            <div class=\"header-brand\">\r\n                <img class=\"header-emblem\" src=\"https://sz.xpu.edu.cn/auth2/img/logo1.png\" alt=\"\">\r\n                <img class=\"header-title\" src=\"https://sz.xpu.edu.cn/auth2/img/logo2.png\" alt=\"\">\r\n            </div>\r\n            \r\n        </div>\r\n        <div class=\"con\">\r\n            <img src=\"https://sz.xpu.edu.cn/auth2/img/ct.png\" alt=\"\" class=\"ct\">\r\n            <div class=\"panel-stack\">\r\n            <!--            忘记密码-->\r\n            <div class=\"content\" id=\"wrap1\">\r\n                <div class=\"title title1\" id=\"title1\">\r\n                    <img id=\"back\" src=\"https://sz.xpu.edu.cn/auth2/img/jt.png\" alt=\"\">\r\n                    <span>忘记密码</span>\r\n                </div>\r\n                <div class=\"group\">\r\n                    <div>\r\n                        <label for=\"username\">+86 <img class=\"jtx\" src=\"https://sz.xpu.edu.cn/auth2/img/jt.png\" alt=\"\"></label>\r\n                        <label for=\"phone\"></label><input type=\"text\" name=\"username\" id=\"phone\"\r\n                                                          placeholder=\"请输入手机号\">\r\n                    </div>\r\n                    <div>\r\n\r\n                        <label for=\"verifyCode\"></label><input type=\"text\" oninput=\"value=value.replace(/\\D/g,'')\"\r\n                                                               maxlength=\"6\" name=\"password\" id=\"verifyCode\" disabled\r\n                                                               placeholder=\"请输入手机验证码\">\r\n                        <label for=\"password\" id=\"getCode\" class=\"get-code\">获取验证码</label>\r\n                    </div>\r\n                    <div>\r\n                        <label for=\"newPwd\"></label><input type=\"password\" name=\"password\" id=\"newPwd\"\r\n                                                           placeholder=\"请输入新密码\">\r\n                    </div>\r\n                    <div>\r\n                        <label for=\"newPwd1\"></label><input type=\"password\" name=\"password\" id=\"newPwd1\"\r\n                                                            placeholder=\"请确认新密码\">\r\n                    </div>\r\n                </div>\r\n                <div style=\"padding: 0 20px\">\r\n                    <button type=\"submit\" class=\"sub_btn\" id=\"edit\">确定</button>\r\n                </div>\r\n\r\n            </div>\r\n            <!--            登录-->\r\n            <div class=\"content\" id=\"wrap\">\r\n                <button type=\"button\" class=\"login-corner sms-corner\" data-login-mode=\"sms\" title=\"短信验证码登录\">\r\n                    <span class=\"sms-icon\" aria-hidden=\"true\"></span>\r\n                </button>\r\n                <div class=\"title\" id=\"title\">\r\n                    <div class=\"login-tabs\">\r\n                        <span class=\"center\" data-login-mode=\"password\">账号密码</span>\r\n                        <span data-login-mode=\"scan\">扫码登录</span>\r\n                    </div>\r\n                </div>\r\n                <div id=\"passLogin\">\r\n                    <div class=\"group\">\r\n                        <input type=\"hidden\" id=\"csrf\" name=\"csrf\" value=\"bd966580-f8fd-4130-8e49-c7b7974d46f2\"/>\r\n                        <input type=\"hidden\" id=\"middleKey\" value=\"A3a71\">\r\n                        <input type=\"hidden\" id=\"schoolCode\" value=\"10709\">\r\n                        <div>\r\n                            <img src=\"https://sz.xpu.edu.cn/auth2/img/yhd.png\" alt=\"\">\r\n                            <label for=\"username\"></label><input type=\"text\" name=\"username\" id=\"username\"\r\n                                                                 placeholder=\"请输入账号/手机号/身份证号\">\r\n                        </div>\r\n                        <div style=\"margin-bottom: 5px\">\r\n                            <img src=\"https://sz.xpu.edu.cn/auth2/img/mmd.png\" alt=\"\">\r\n                            <label for=\"password\"></label>\r\n                            <input type=\"password\" name=\"password\" id=\"password\"\r\n                                   placeholder=\"请输入密码\">\r\n                            <img class=\"yj\" id=\"yjxs\" src=\"https://sz.xpu.edu.cn/auth2/img/yjxs.png\">\r\n                            <img class=\"yj\" style=\"display: none;\" id=\"yjyc\" src=\"https://sz.xpu.edu.cn/auth2/img/yjyc.png\">\r\n                        </div>\r\n                        <p class=\"tips\">忘记密码</p>\r\n                    </div>\r\n                    <div style=\"padding: 0 20px\">\r\n                        <button type=\"submit\" class=\"sub_btn\" id=\"loginVerify\">登录</button>\r\n                    </div>\r\n                    \r\n                    <div class=\"hint-login\">温馨提示: 账号为工号或学号，初始密码为身份证后6位</div>\r\n                </div>\r\n                <div id=\"smsLogin\" style=\"display: none\">\r\n                    <div class=\"group\">\r\n                        <div>\r\n                            <img src=\"https://sz.xpu.edu.cn/auth2/img/yhd.png\" alt=\"\">\r\n                            <label for=\"smsPhone\"></label><input type=\"text\" name=\"smsPhone\" id=\"smsPhone\"\r\n                                                                  maxlength=\"11\"\r\n                                                                  oninput=\"value=value.replace(/\\D/g,'')\"\r\n                                                                  placeholder=\"请输入手机号\">\r\n                        </div>\r\n                        <div style=\"margin-bottom: 5px\">\r\n                            <img src=\"https://sz.xpu.edu.cn/auth2/img/mmd.png\" alt=\"\">\r\n                            <label for=\"smsCode\"></label><input type=\"text\" name=\"smsCode\" id=\"smsCode\"\r\n                                                                 maxlength=\"6\"\r\n                                                                 oninput=\"value=value.replace(/\\D/g,'')\"\r\n                                                                 placeholder=\"请输入短信验证码\">\r\n                            <label for=\"smsCode\" id=\"getLoginCode\" class=\"get-code\">获取验证码</label>\r\n                        </div>\r\n                    </div>\r\n                    <div style=\"padding: 0 20px\">\r\n                        <button type=\"submit\" class=\"sub_btn\" id=\"smsLoginVerify\">登录</button>\r\n                    </div>\r\n                    <p class=\"sms-login-tip\">短信验证码仅发送至系统中已存在的手机号</p>\r\n                </div>\r\n                <div id=\"codeLogin\" style=\"display: flex\">\r\n                    <div style=\"padding: 0 20px;position: relative\">\r\n                        <img style=\"width: 250px;height: 250px\" id=\"qrImage\" alt=\"\" src=\"\">\r\n                        <div id=\"scanFail\" class=\"qrcode_error\" style=\"display: none\">\r\n                            <div>\r\n                                <span>扫码失败</span>\r\n                                <div id=\"refresh_fail\" class=\"refresh_code\">刷新二维码</div>\r\n                            </div>\r\n                        </div>\r\n                        <div id=\"scanSuccess\" class=\"qrcode_success\" style=\"display: none\">\r\n                            <div>\r\n                                <img class=\"success_img\" src=\"https://sz.xpu.edu.cn/auth2/img/qrcode_success.png\" alt=\"\">\r\n                                <div class=\"success_text\">扫描成功</div>\r\n                                <div class=\"success_tips\">请在手机上根据提示确认登录！</div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"hint-login\">请使用西安工程大学APP扫码登录</div>\r\n                        <div class=\"maskBox\" id=\"refresh-code\">\r\n                            <img src=\"https://sz.xpu.edu.cn/auth2/img/sx.png\" alt=\"\">\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n                <div class=\"mask\">\r\n                    <div class=\"title1\">请完成安全验证</div>\r\n                    <div id=\"content\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"footer\">\r\n            <span>版权所有：西安工程大学</span>\r\n            <span>地址：中国·西安·金花南路19号[710048]</span>\r\n        </div>\r\n        <div class=\"img-list\">\r\n            <div class=\"img-list-box\">\r\n                <img src=\"https://sz.xpu.edu.cn/auth2/img/ios.png\" alt=\"\">\r\n                <p>IOS客户端</p>\r\n                <img src=\"https://sz.xpu.edu.cn/auth2/img/android.png\" alt=\"\">\r\n                <p>安卓客户端</p>\r\n                <div class=\"sj\"></div>\r\n            </div>\r\n            <div class=\"img-list-title\">\r\n                <img src=\"https://sz.xpu.edu.cn/auth2/img/ewm.png\" alt=\"\">\r\n                <span>西安工程大学</span>\r\n                <span style=\"letter-spacing: 0\">APP</span>\r\n                <span>下载</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n</body>\r\n<script type=\"text/javascript\">\r\n    //判断配置文件是否开启日志调试 是否输出日志 True 输出 False 不输出\r\n    const logDebug = false;\r\n    console.log = (function (oriLogFunc) {\r\n        return function () {\r\n            if (logDebug) {\r\n                oriLogFunc.apply(this, arguments);\r\n            }\r\n        }\r\n    })(console.log);\r\n\r\n\r\n    let ws; //websocket对象\r\n    const isUseScan = true;\r\n    const title = '教育数字化应用服务平台';\r\n    let closeWs = false;\r\n    $('#codeLogin').css({\r\n        display: 'none'\r\n    })\r\n    $('#titleId').html(function () {\r\n        return title;\r\n    });\r\n\r\n    const footer = '西安工程大学';\r\n    $('#footerId').html(function () {\r\n        return footer;\r\n    });\r\n    $('.tips').click(function () {\r\n        $('#wrap').css({\r\n            display: 'none'\r\n        })\r\n        $('#wrap1').css({\r\n            display: 'block'\r\n        })\r\n    })\r\n    // 密码显示隐藏事件\r\n    $('#passLogin').on('click', '.yj', function () {\r\n        $(this).css({display: 'none'})\r\n        $(this).attr(\"id\") === 'yjxs' ? $('#yjyc').css({display: 'block'}) : $('#yjxs').css({display: 'block'})\r\n        $('#password').attr('type', $(this).attr(\"id\") === 'yjxs' ? 'text' : 'password')\r\n    })\r\n\r\n    function closeWebSocket() {\r\n        if ('WebSocket' in window) {\r\n            if (!!ws) {\r\n                closeWs = true;\r\n                ws.send('{\"TYPE\":\"CLOSE\",\"DATA\":\"ByeBye!!\"}')\r\n                ws.close();\r\n            }\r\n        }\r\n    }\r\n\r\n    function switchLoginMode(mode) {\r\n        $('#wrap [data-login-mode]').removeClass('center');\r\n        $('#wrap [data-login-mode=\"' + mode + '\"]').addClass('center');\r\n        $('#passLogin').css({display: mode === 'password' ? 'block' : 'none'});\r\n        $('#smsLogin').css({display: mode === 'sms' ? 'block' : 'none'});\r\n        $('#codeLogin').css({display: mode === 'scan' ? 'flex' : 'none'});\r\n        if (mode === 'scan') {\r\n            $('#scanSuccess').css({display: 'none'});\r\n            $('#scanFail').css({display: 'none'});\r\n            if (isUseScan) {\r\n                closeWs = false;\r\n                initWebSocket();\r\n            }\r\n        } else if (isUseScan) {\r\n            closeWebSocket();\r\n        }\r\n    }\r\n\r\n    $('#wrap [data-login-mode]').click(function () {\r\n        switchLoginMode($(this).data('login-mode'));\r\n    })\r\n    $('#refresh-code').click(function () {\r\n        $('#refresh-code img').addClass('rotate')\r\n        setTimeout(function () {\r\n            $('#refresh-code img').removeClass('rotate')\r\n        }, 1000)\r\n        if (isUseScan) {\r\n            if (!ws) {//第一次执行，初始化或ws断开时可执行\r\n                initWebSocket()\r\n            }\r\n            ws.send('{\"TYPE\":\"SCAN\"}');\r\n        }\r\n    })\r\n\r\n    $('#refresh_fail').click(function () {\r\n        if (isUseScan) {\r\n            if (!ws) {//第一次执行，初始化或ws断开时可执行\r\n                initWebSocket()\r\n            }\r\n            ws.send('{\"TYPE\":\"SCAN\"}');\r\n            $('#scanSuccess').css({\r\n                display: 'none'\r\n            })\r\n            $('#scanFail').css({\r\n                display: 'none'\r\n            })\r\n        }\r\n    })\r\n\r\n    $('#back').click(function () {\r\n        $('#wrap').css({\r\n            display: 'block'\r\n        })\r\n        $('#wrap1').css({\r\n            display: 'none'\r\n        })\r\n    })\r\n    $('#getCode').click(function () {\r\n        var phone = $('#phone').val()\r\n        if ($('#getCode').html() !== '获取验证码') return false;\r\n        if (!phone) return layer.msg('请输入手机号');\r\n        if (!(/^1[3456789]\\d{9}$/.test(phone))) return layer.msg('请输入正确的手机号');\r\n        startSlideVerify(function (captchaVerification) {\r\n            sendPublicSms(\"https://sz.xpu.edu.cn/auth2/api/v2/sendForgetSms\", phone, captchaVerification, function (res) {\r\n                if (res.errorCode !== 0) {\r\n                    toast(res.message || '验证码发送失败，请稍后重试');\r\n                    return;\r\n                }\r\n                $('#verifyCode').prop('disabled', false);\r\n                startSmsCountdown('#getCode', 300);\r\n                toast(res.message || '短信已发送');\r\n            }, function () {\r\n                toast('验证码发送失败，请稍后重试');\r\n            });\r\n        });\r\n    })\r\n\r\n    $('#getLoginCode').click(function () {\r\n        var phone = $('#smsPhone').val()\r\n        if ($('#getLoginCode').html() !== '获取验证码') return false;\r\n        if (!phone) return layer.msg('请输入手机号');\r\n        if (!(/^1[3456789]\\d{9}$/.test(phone))) return layer.msg('请输入正确的手机号');\r\n        startSlideVerify(function (captchaVerification) {\r\n            sendPublicSms(\"https://sz.xpu.edu.cn/auth2/api/v2/sendLoginSms\", phone, captchaVerification, function (res) {\r\n                if (res.errorCode !== 0) {\r\n                    toast(res.message || '验证码发送失败，请稍后重试');\r\n                    return;\r\n                }\r\n                startSmsCountdown('#getLoginCode', 60);\r\n                toast(res.message || '短信已发送');\r\n            }, function () {\r\n                toast('验证码发送失败，请稍后重试');\r\n            });\r\n        });\r\n    })\r\n\r\n    function sendPublicSms(url, phone, captchaVerification, onSuccess, onError) {\r\n        var headers = {};\r\n        headers['X-CSRF-TOKEN'] = $(\"#csrf\").val();\r\n        $.ajax({\r\n            type: \"POST\",\r\n            url: url,\r\n            headers: headers,\r\n            contentType: \"application/json; charset=utf-8\",\r\n            data: JSON.stringify({\r\n                phone: phone,\r\n                captchaVerification: captchaVerification\r\n            }),\r\n            dataType: \"JSON\",\r\n            success: function (res) {\r\n                $('.mask').css({\r\n                    display: 'none'\r\n                })\r\n                if (onSuccess) {\r\n                    onSuccess(res);\r\n                }\r\n            },\r\n            error: function () {\r\n                $('.mask').css({\r\n                    display: 'none'\r\n                })\r\n                if (onError) {\r\n                    onError();\r\n                }\r\n            }\r\n        });\r\n    }\r\n\r\n    function toast(msg) {\r\n        if (msg == null || msg === '') {\r\n            msg = '操作成功';\r\n        } else if (typeof msg !== 'string') {\r\n            msg = String(msg);\r\n        }\r\n        layer.msg(msg);\r\n    }\r\n\r\n    function startSmsCountdown(selector, seconds) {\r\n        var time = seconds;\r\n        $(selector).html(time + 's后重新获取');\r\n        var timer = setInterval(function () {\r\n            time--;\r\n            if (time <= 0) {\r\n                clearInterval(timer);\r\n                $(selector).html('获取验证码');\r\n                return;\r\n            }\r\n            $(selector).html(time + 's后重新获取');\r\n        }, 1000);\r\n    }\r\n\r\n    function startSlideVerify(onSuccess) {\r\n        $('.mask').css({\r\n            display: 'block'\r\n        })\r\n        $('#content').html('')\r\n        $('#content').slideVerify({\r\n            baseUrl: 'https://sz.xpu.edu.cn/auth2',  //服务器请求地址, 默认地址为安吉服务器;\r\n            containerId: 'btn',//pop模式 必填 被点击之后出现行为验证码的元素id\r\n            mode: 'fixed',     //展示模式\r\n            imgSize: {       //图片的大小对象,有默认值{ width: '310px',height: '155px'},可省略\r\n                width: '380px',\r\n                height: '195px',\r\n            },\r\n            barSize: {          //下方滑块的大小对象,有默认值{ width: '310px',height: '50px'},可省略\r\n                width: '380px',\r\n                height: '40px',\r\n            },\r\n            beforeCheck: function () {  //检验参数合法性的函数  mode =\"pop\"有效\r\n                //实现: 参数合法性的判断逻辑, 返回一个boolean值\r\n                return true\r\n            },\r\n            ready: function () {\r\n            },  //加载完毕的回调\r\n            success: function (params) { //成功的回调\r\n                // params为返回的二次验证参数 需要在接下来的实现逻辑回传服务器\r\n                // 例如: login($.extend({}, params))\r\n                onSuccess(params.captchaVerification);\r\n            },\r\n            error: function () {\r\n            }        //失败的回调\r\n        });\r\n    }\r\n\r\n    $('#loginVerify').click(function () {\r\n        var name = $(\"#username\").val();\r\n        var pass = $(\"#password\").val();\r\n        if (!name) {\r\n            layer.msg('请输入用户名');\r\n            return false;\r\n        }\r\n        if (!pass) {\r\n            layer.msg('请输入密码');\r\n            return false;\r\n        }\r\n        startSlideVerify(function (captchaVerification) {\r\n            login(captchaVerification, name, pass, 'PWD');\r\n        });\r\n    })\r\n\r\n    $('#smsLoginVerify').click(function () {\r\n        var phone = $(\"#smsPhone\").val();\r\n        var code = $(\"#smsCode\").val();\r\n        if (!phone) {\r\n            layer.msg('请输入手机号');\r\n            return false;\r\n        }\r\n        if (!(/^1[3456789]\\d{9}$/.test(phone))) {\r\n            layer.msg('请输入正确的手机号');\r\n            return false;\r\n        }\r\n        if (!code) {\r\n            layer.msg('请输入短信验证码');\r\n            return false;\r\n        }\r\n        login('', phone, code, 'SMS');\r\n    })\r\n\r\n    $('#edit').click(function () {\r\n        var pwd = $('#newPwd').val().replace(/\\s*/g, \"\")\r\n        var newPwd = $('#newPwd1').val().replace(/\\s*/g, \"\")\r\n        var phone = $('#phone').val()\r\n        var code = $('#verifyCode').val()\r\n        const reg = /^(?=.*([A-Za-z].*))(?=.*[0-9]).*[A-Za-z0-9-*/+.!@#$%^&()_=]{8,20}$/;\r\n        if (!phone) return layer.msg('请输入手机号');\r\n        if (!code) return layer.msg('请输入验证码');\r\n        if (!pwd) return layer.msg('请输入新密码');\r\n        if (pwd !== newPwd) return layer.msg('两次输入的密码不一致!');\r\n        if (!reg.test(pwd)) return layer.msg('新密码需包括字母、数字、字符，8-20位!');\r\n        $.ajax({\r\n            type: \"post\",\r\n            url: \"https://sz.xpu.edu.cn/auth2/api/v2/updateForgetPwd?_csrf=\" + $(\"#csrf\").val(),\r\n            dataType: \"JSON\",\r\n            contentType: \"application/json; charset=utf-8\",\r\n            data: JSON.stringify({\r\n                phone,\r\n                code,\r\n                newPwd: Secret_Key(pwd, code, 'E')\r\n            }),\r\n            success: function (result) {\r\n                if (result.errorCode !== 0) return layer.msg(result.message);\r\n                layer.msg('密码修改成功，请重新登录');\r\n                $('#wrap').css({\r\n                    display: 'block'\r\n                })\r\n                $('#wrap1').css({\r\n                    display: 'none'\r\n                })\r\n            },\r\n            error: function () {\r\n\r\n            }\r\n        });\r\n    })\r\n\r\n    function login(code, name, pass, loginType) {\r\n        const schoolCode = $(\"#schoolCode\").val();\r\n        const csrf = $(\"#csrf\").val();\r\n        const key = $(\"#middleKey\").val();\r\n        name = Secret_Key(name, key, 'E');\r\n        pass = Secret_Key(pass, key, 'E');\r\n        $.ajax({\r\n            type: \"POST\",\r\n            url: \"https://sz.xpu.edu.cn/auth2/cloud/login\",\r\n            data: {\r\n                username: name,\r\n                password: pass,\r\n                schoolCode: schoolCode,\r\n                code: code,\r\n                loginType: loginType || 'PWD',\r\n                _csrf: csrf\r\n            },\r\n            dataType: \"JSON\",\r\n            success: function (result) {\r\n                $('.mask').css({\r\n                    display: 'none'\r\n                })\r\n                if (result.errorCode !== 0) {\r\n                    layer.msg(result.message);\r\n                    if (result.message.includes('登录超时')) {\r\n                        location.reload();\r\n                    }\r\n                } else {\r\n                    if (ws != null) {\r\n                        ws.send('{\"TYPE\":\"CLOSE\",\"DATA\":\"ByeBye!!\"}')\r\n                        ws.close();\r\n                    }\r\n                    window.location.href = result.data;\r\n                }\r\n            },\r\n            error: function () {\r\n                location.reload();\r\n            }\r\n        });\r\n    }\r\n\r\n    function scanLogin(id) {\r\n        var csrf = $(\"#csrf\").val();\r\n        $.ajax({\r\n            type: \"POST\",\r\n            url: \"https://sz.xpu.edu.cn/auth2/scanLogin?_csrf=\" + csrf,\r\n            data: JSON.stringify({id}),\r\n            dataType: \"JSON\",\r\n            contentType: \"application/json; charset=utf-8\",\r\n            success: function (result) {\r\n                layer.msg(result.message, {\r\n                    time: 2000 //2秒关闭（如果不配置，默认是3秒）\r\n                }, function () {\r\n                    if (result.errorCode === 0) {\r\n                        window.location.href = result.data;\r\n                    } else {\r\n                        location.reload();\r\n                    }\r\n                });\r\n            },\r\n            error: function () {\r\n                location.reload();\r\n            }\r\n        });\r\n    }\r\n\r\n    function initWebSocket() {\r\n        try {\r\n            if ('WebSocket' in window) {\r\n                ws = new WebSocket('wss://sz.xpu.edu.cn/auth2/webSocket/scanCode')\r\n                console.log('ws连接状态：' + ws.readyState);\r\n            }\r\n            initHandle();\r\n        } catch (e) {\r\n            console.log(e)\r\n            if (maxTry > curCount) {\r\n                reconnectWs();\r\n            }\r\n        }\r\n    }\r\n\r\n    function initHandle() {\r\n        //监听是否连接成功\r\n        ws.onopen = function () {\r\n            console.log('ws连接状态：' + ws.readyState);\r\n            //连接成功则发送一个数据\r\n            ws.send('{\"TYPE\":\"REGISTER\",\"DATA\":\"Hello!\"}');\r\n            ws.send('{\"TYPE\":\"SCAN\"}')\r\n            ws_heartCheck.reset().start();\r\n        }\r\n        // 接听服务器发回的信息并处理展示\r\n        ws.onmessage = function (data) {\r\n            ws_heartCheck.reset().start();\r\n            const data1 = JSON.parse(data.data);\r\n            console.log('接收到来自服务器的消息：');\r\n            switch (data1.type) {\r\n                case \"SCAN\":\r\n                    //显示二维码\r\n                    $('#qrImage').attr('src', data1.data)\r\n                    break;\r\n                case \"APPSCAN\":\r\n                    //提示APP扫码\r\n                    $('#scanSuccess').css({\r\n                        display: 'block'\r\n                    })\r\n                    $('#scanFail').css({\r\n                        display: 'none'\r\n                    })\r\n                    break;\r\n                case \"LOGIN\":\r\n                    //执行扫码登录\r\n                    const id = data1.data;\r\n                    scanLogin(id);\r\n                    break\r\n                case \"CLOSE\":\r\n                    ws.close();\r\n                    break;\r\n                case \"CANCEL\":\r\n                    $('#scanFail').css({\r\n                        display: 'flex'\r\n                    })\r\n                    $('#scanSuccess').css({\r\n                        display: 'none'\r\n                    })\r\n                    break\r\n                case \"REFRESH\":\r\n                    ws.send('{\"TYPE\":\"SCAN\"}')\r\n                    break\r\n                default:\r\n                    console.log(data1);\r\n                    break\r\n            }\r\n        }\r\n        // 监听连接关闭事件\r\n        ws.onclose = function () {\r\n            // 监听整个过程中websocket的状态\r\n            console.log('ws连接状态：' + ws.readyState);\r\n            if (maxTry > curCount  && !closeWs) {\r\n                reconnectWs();\r\n            }\r\n        }\r\n        // 监听并处理error事件\r\n        ws.onerror = function (error) {\r\n            console.log(error);\r\n            if (maxTry > curCount  && !closeWs) {\r\n                reconnectWs();\r\n            }\r\n        }\r\n\r\n    }\r\n\r\n    const maxTry = 10;\r\n    let curCount = 0;\r\n\r\n    function reconnectWs() {\r\n        let lockConn = false;\r\n        if (lockConn) return;\r\n        lockConn = true;\r\n\r\n        setTimeout(function () {\r\n            initWebSocket();\r\n            lockConn = false;\r\n        }, 5000)\r\n        curCount++;\r\n    }\r\n\r\n    window.onbeforeunload = function () {\r\n        if (!!ws) {\r\n            closeWs = true;\r\n            ws.send('{\"TYPE\":\"CLOSE\",\"DATA\":\"Bye Bye!\"}');\r\n            ws.close();\r\n        }\r\n    }\r\n\r\n    // WebSocket心跳检测\r\n    const ws_heartCheck = {\r\n        timeout: 30000,\t\t\t// 5秒一次心跳\r\n        timeoutObj: null,\t\t// 执行心跳的定时器\r\n        serverTimeoutObj: null,\t// 服务器超时定时器\r\n        reset: function () {\t\t// 重置方法\r\n            clearTimeout(this.timeoutObj);\r\n            clearTimeout(this.serverTimeoutObj);\r\n            return this;\r\n        },\r\n        start: function () {\t\t// 启动方法\r\n            const self = this;\r\n            this.timeoutObj = setTimeout(function () {\r\n                // 这里发送一个心跳信息，后端收到后，返回一个消息，在onmessage拿到返回的心跳（信息）就说明连接正常\r\n                ws.send('{\"TYPE\":\"HEART\",\"DATA\":\"i am alive!\"}');\r\n                // 如果超过一定时间还没重置，说明后端主动断开了\r\n                self.serverTimeoutObj = setTimeout(function () {\r\n                    // 如果onclose会执行reconnect，我们执行ws.close()就行了.如果直接执行reconnect 会触发onclose导致重连两次\r\n                    ws.close();\r\n                }, self.timeout);\r\n            }, this.timeout);\r\n        }\r\n    };\r\n</script>\r\n\r\n</html>\r\n"
          },
